            "name": "自定义分类",
            "items": {
              "category_name": {
                "description": "分类名称 (ID)",
                "type": "string",
                "default": "新分类",
                "hint": "分类卡片标题，也是插件归类的分组名"
              },
              "enabled": {
                "description": "启用此规则",
                "type": "bool",
                "default": true,
                "hint": "关闭后该规则不参与匹配（临时停用无需删除）"
              },
              "keywords": {
                "description": "匹配关键词",
                "type": "list",
                "default": [],
                "hint": "插件描述/名称/展示名/标签中出现任一关键词即归入本分类（大小写不敏感，支持中英文）"
              },
              "color": {
                "description": "分类主题色",
                "type": "string",
                "default": "slot_8",
                "hint": "默认绑定备用色槽 slot_8（随主题换色）；可改其它 slot_0~slot_9 或固定 #RRGGBB；留空则按列表顺序自动分配"
              }
            },
            "display_item": "category_name"
          }
        }
      }
    }
  },
  "rendering": {
    "description": "渲染引擎设置",
    "type": "object",
    "items": {
      "timeout_analysis": {
        "description": "数据分析超时 (秒)",
        "type": "float",
        "slider": {
          "min": 3,
          "max": 30,
          "step": 1
        },
        "default": 10.0,
        "hint": "生成数据结构的超时时间，根据插件数量调整"
      },
      "timeout_compile": {
        "description": "Typst 编译超时 (秒)",
        "type": "float",
        "slider": {
          "min": 3,
          "max": 60,
          "step": 1
        },
        "default": 30.0,
        "hint": "调用 Typst 编译图片的超时时间，根据其他项目调整"
      },
      "max_concurrent_tasks": {
        "description": "最大并发编译数",
        "type": "int",
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        },
        "default": 2,
        "hint": "同时进行的 Typst 编译任务数量限制，根据 CPU 调整"
      },
      "ppi": {
        "description": "图片清晰度 (PPI)",
        "type": "float",
        "slider": {
          "min": 72,
          "max": 256,
          "step": 1
        },
        "default": 180.0,
        "hint": "越高图片越清晰，但越慢&大&高占用，根据内存 & 带宽调整"
      },
      "page_width": {
        "description": "页面总宽度 (pt)",
        "type": "float",
        "slider": {
          "min": 480,
          "max": 1200,
          "step": 10
        },
        "default": 830.0,
        "hint": "整张面板的宽度，分栏列宽随它等比变化；调窄后同一清晰度下图片更窄、文字相对更大，手机聊天窗口里更清楚"
      },
      "single_column_threshold": {
        "description": "单列切换阈值 (pt)",
        "type": "float",
        "slider": {
          "min": 480,
          "max": 1200,
          "step": 10
        },
        "default": 680.0,
        "hint": "页面总宽度低于该值时改为单列排版，避免两列/三列挤在一起；不小于页面总宽度时即为强制单列"
      },
      "giant_threshold": {
        "description": "巨型块阈值 (pt)",
        "type": "int",
        "slider": {
          "min": 100,
          "max": 3000,
          "step": 100
        },
        "default": 1500,
        "hint": "超过此高度的插件将独占一行显示 (仅 Event/Filter 模式有效)"
      },
      "webp_limit": {
        "description": "WebP 单图高度上限 (px)",
        "type": "int",
        "slider": {
          "min": 1000,
          "max": 16383,
          "step": 1
        },
        "default": 16383,
        "hint": "超过该高度的长图会自动切分为多张；WebP 格式单图高度最高 16383，通常无需修改"
      },
      "split_height": {
        "description": "长图切分高度 (px)",
        "type": "int",
        "slider": {
          "min": 1000,
          "max": 16000,
          "step": 1000
        },
        "default": 16000,
        "hint": "当图片高度超过 WebP 限制时的切分单位高度"
      }
    }
  },
